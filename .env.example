# ==========================================
# Application
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# MySQL
# ==========================================
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/graduation_design

# ==========================================
# UniParse / OCR
# ==========================================
PARSER_API=replace-with-your-parser-api-token

# ==========================================
# LLM API (OpenAI-compatible)
# ==========================================
LLM_API_BASE=https://api.example.com/v1
LLM_MODEL=replace-with-your-llm-model
LLM_API_KEY=replace-with-your-llm-api-key
LLM_TIMEOUT=60
LLM_VERIFY_SSL=true
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9

# ==========================================
# Neo4j
# ==========================================
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
AUTO_SETUP_LOCAL_NEO4J=false

# ==========================================
# GraphRAG LLM
# ==========================================
GRAPHRAG_LLM_MODEL=replace-with-your-graphrag-llm-model

# ==========================================
# GraphRAG vector index and node config
# ==========================================
GRAPHRAG_VECTOR_INDEX_NAME=chunk_vector_index
GRAPHRAG_VECTOR_NODE_LABEL=Chunk
GRAPHRAG_VECTOR_EMBEDDING_PROPERTY=embedding
GRAPHRAG_VECTOR_TEXT_PROPERTY=text

# ==========================================
# Embedding service
# ==========================================
LOCAL_EMBEDDING_BASE_URL=http://localhost:9091
LOCAL_EMBEDDING_API_PATH=/v1/embeddings
LOCAL_EMBEDDING_TIMEOUT=30
GRAPHRAG_EMBEDDING_MODEL=Qwen3-Embedding-8B
GRAPHRAG_EMBEDDING_DIMENSIONS=4096
GRAPHRAG_SIMILARITY_FN=cosine

# ==========================================
# GraphRAG sync and chunking defaults
# ==========================================
GRAPHRAG_SYNC_LIMIT=100
GRAPHRAG_SYNC_CHUNK_SIZE=800
GRAPHRAG_SYNC_CHUNK_OVERLAP=120
GRAPHRAG_TRIPLET_MAX_WORKERS=4
GRAPHRAG_PAPER_MAX_WORKERS=4

# ==========================================
# GraphRAG semantic chunking
# ==========================================
GRAPHRAG_SEMANTIC_CHUNK_MIN_LEN_ABS=120
GRAPHRAG_SEMANTIC_CHUNK_MIN_LEN_RATIO=0.35
GRAPHRAG_SEMANTIC_DROP_QUANTILE=0.90
GRAPHRAG_SEMANTIC_LOW_SIM_QUANTILE=0.20
GRAPHRAG_SEMANTIC_FALLBACK_LOW_SIM_QUANTILE=0.10
